# Shared
NODE_ENV=development

# Backend
API_PORT=3000
API_GLOBAL_PREFIX=api
DATABASE_URL="mysql://campus:campus_password@localhost:3307/campus_team_platform"
JWT_SECRET="replace-with-a-local-development-secret"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN="http://localhost:5173"
APP_FRONTEND_URL="http://localhost:5173"
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFY_TOKEN_TTL_MINUTES=30

# Frontend
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_WS_BASE_URL="ws://localhost:3000"
VITE_UI_CONFIG_SERVICE_URL="http://localhost:4317/ui-overrides"
VITE_API_TIMEOUT_MS=75000

# AI (可选；不配置时将使用本地回退回答)
OPENAI_API_KEY="在 GAI Token Hub 创建的 API Key"
AI_MODEL="kimi-k2.7-code"
AI_GATEWAY_URL="https://njusehub.info/v1/chat/completions"
AI_REQUEST_TIMEOUT_MS="60000"
AI_CONFIG_MASTER_KEY="replace-with-a-long-random-secret"

# Database container
MYSQL_DATABASE=campus_team_platform
MYSQL_USER=campus
MYSQL_PASSWORD=campus_password
MYSQL_ROOT_PASSWORD=root_password

# Mail
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=你的邮箱@qq.com
MAIL_PASS=你的邮箱SMTP授权码
MAIL_FROM="校园组队平台 <你的邮箱@qq.com>"
